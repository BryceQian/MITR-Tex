% 期刊使用全称；pages 用 -- 表示起止页码；不必手动填写 [J] 等标识。

@article{example-journal-cn,
  author       = {作者甲 and 作者乙 and 作者丙 and 作者丁},
  title        = {中文期刊论文题名（格式示例）},
  journaltitle = {期刊全称（格式示例）},
  date         = {2026},
  volume       = {12},
  number       = {3},
  pages        = {45--52},
  langid       = {chinese}
}

@article{example-journal-en,
